{
  "manifest_version": 3,
  "name": "Archives - Bascule Edge",
  "description": "Réactive Les Archives depuis le bouton Owlbear, sans recharger le canevas.",
  "version": "1.0.0",
  "host_permissions": ["https://toniogervais.github.io/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://www.owlbear.rodeo/*","https://owlbear.rodeo/*"],
    "js": ["owlbear-bridge.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "icons":{"16":"icon16.png","48":"icon48.png","128":"icon128.png"}
}
